}

.textoRecursos1 .frente.frente2 {
  top: -1px; left: -1px; right: -1px; bottom: -1px;
  background: transparent;
  box-shadow: 0 0 10px var(--bg);
  border-left: 2px solid var(--accent-dim);
  border-top: 2px solid var(--accent-dim);
  animation: girar 0.34s linear reverse infinite;
}

.textoRecursos1 .frente .circulo {
  position: absolute;
  top: calc(50% - 1px);
  left: 50%;
  transform-origin: left;
  width: 50%;
  height: 2px;
}

.textoRecursos1 .frente.frente1 .circulo {
  transform: rotate(-45deg);
}

.textoRecursos1 .frente.frente2 .circulo {
  transform: rotate(45deg);
}


.textoRecursos1 .frente.frente1 .circulo::before {
  background: var(--accent-dim);
  box-shadow:
    0 0 30px var(--accent-dim),
    0 0 40px var(--accent-dim),
    0 0 60px var(--accent-dim),
    0 0 80px var(--accent-dim),
    0 0 100px var(--accent-dim),
