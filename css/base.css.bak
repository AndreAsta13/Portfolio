}


/* ════════════════════════════════════════════
   RECURSOS2 — Captações de Movimentos (círculo + tópicos)
════════════════════════════════════════════ */
#recursos2 {
  position: relative;
  min-height: 100vh;
  max-width: 3000px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 6rem 5% 5rem;
  overflow: hidden;

}

.recursos2-layout {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 10rem;
  width: 100%;
  max-width: 1400px;
}

.textoRecursos2 {
  position: relative;
  background: transparent;
  width: 400px;
  height: 600px;
  box-sizing: border-box;
}

.textoRecursos2 h2 {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 6;
  width: 100%;
  background: transparent;
  text-align: center;
  font-size: 22px;
  color: var(--text);
  border-color: var(--border);
  letter-spacing: 3px;
  text-transform: uppercase;
  transition: transform .5s;
}

.textoRecursos2 .frente {
  position: absolute;
  border-radius: 50%;
  border: 2px solid transparent;
}

.textoRecursos2 .frente.frente1 {
  top: 2px; left: 2px; right: 2px; bottom: 2px;
  background: transparent;
  box-shadow: 0 0 10px transparent;
  border-left: 2px solid transparent;
  border-top: 7px solid transparent;
  animation: girar 4s linear infinite;
}

.textoRecursos2 .frente.frente2 {
  top: -1px; left: -1px; right: -1px; bottom: -1px;
  background: transparent;
  box-shadow: 0 0 10px transparent;
  border-left: 2px solid transparent;
  border-top: 7px solid transparent;
  animation: girar 4s linear reverse infinite;
}

.textoRecursos2  .circulo {
  position: absolute;
  top: calc(50% - 1px);
  left: 50%;
  transform-origin: left;
  width: 50%;
  height: 2px;
  
}

.textoRecursos2 .frente.frente1 .circulo {
  transform: rotate(45deg);
}

.textoRecursos2 .frente.frente2 .circulo {
  transform: rotate(-180deg);
}

.textoRecursos2 .frente .circulo::before {
  content: '';
  position: absolute;
  top: -4px;
  right: -6px;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--accent);
}

.textoRecursos2 .frente.frente1 .circulo::before {
  background: var(--accent-dim);
  box-shadow:
    0 0 30px var(--accent-dim),
    0 0 40px var(--accent-dim),
    0 0 60px var(--accent-dim),
    0 0 80px var(--accent-dim),
    0 0 100px var(--accent-dim),
    0 0 5px var(--lilas);
}

.textoRecursos2 .frente.frente2 .circulo::before {
  background: var(--accent);
  box-shadow:
    0 0 30px var(--accent),
    0 0 40px var(--accent),
    0 0 60px var(--accent),
    0 0 80px var(--accent),
    0 0 100px var(--accent),
    0 0 5px var(--yellow);
}


/* Animação compartilhada pelos três círculos */
@keyframes girar {
  0%   { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
/* ════════════════════════════════════════════
   RECURSOS0 — Acessibilidade (círculo + tópicos)
════════════════════════════════════════════ */
