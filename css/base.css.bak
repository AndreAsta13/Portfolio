/* ════════════════════════════════════════════
   TÓPICOS — compartilhado por recursos1 e recursos2
════════════════════════════════════════════ */
.topicos-coluna {
  display: flex;
  flex-direction: column;
  gap: 8rem;
  flex: 1;
  max-width: 7020px;
}

.topicos-esquerda {
  align-items: flex-end;   /* textos "encostam" no círculo, alinhados à direita da coluna */
  text-align: left;
}

.topicos-direita-texto {
  align-items: flex-start; /* textos "encostam" no círculo, alinhados à esquerda da coluna */
  text-align: right;
}
.topicos-esquerda-texto {
  align-items: flex-end;   /* textos "encostam" no círculo, alinhados à direita da coluna */
  text-align: left;
}

.topicos-direita {
  align-items: flex-start; /* textos "encostam" no círculo, alinhados à esquerda da coluna */
  text-align: right;
}
.topico-item {
  padding: 1rem 1.25rem;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  cursor: default;
  transition: border-color var(--transition), background var(--transition);
  width: 130%;
  
}
.topico-item h3 {
 font-size: 24px;
 max-width: 1000px;

}

.topico-item:hover {
  border-color: var(--accent);
  background: rgba(200, 245, 90, .06);
}

.topico-titulo {
  font-size: 1rem;
  font-weight: 700;
  color: var(--white);
  margin: 0;
  letter-spacing: .02em;
  
}

.topico-texto {
  font-size: .85rem;
  color: var(--muted);
  line-height: 1.6;
  margin-top: .5rem;
 

  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transition: max-height .4s ease, opacity .3s ease, margin-top .4s ease;
}
.topicos-esquerda .topico-item:nth-child(2) {
  margin-right: 6.5rem;
  transition: border-color var(--transition), background var(--transition), margin-right var(--transition);
  
}


.topicos-direita .topico-item:nth-child(2) {
  margin-left: 6.5rem;
  transition: border-color var(--transition), background var(--transition), margin-left var(--transition);
  
}
/* Revela ao passar o mouse */
.topico-item:hover .topico-texto {
  max-height: 200px;
  opacity: 1;
}

/* Sem texto visível ainda: sem margem extra */
.topico-item:not(:hover) .topico-texto {
  margin-top: 0;
}

/* ════════════════════════════════════════════
   SOBRE
════════════════════════════════════════════ */
#sobre {
  position: relative;
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 6rem 5% 2rem;
  overflow: hidden;
  background-image: url('../assets/madeira.png');
  
}

.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  align-items: center;
  max-width: 1160px;
  margin: 0 auto;
  background: rgba(0, 0, 0, .25);
}

/* Foto */
.about-placeholder {
  border-radius: var(--radius-lg);
  overflow: hidden;
  position: relative;
  aspect-ratio: 4/5;
  background: var(--surface2);
}

.about-placeholder::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: var(--radius-lg);
  border: 1px solid rgba(200,245,90,.15);
  pointer-events: none;
}

.imageandre {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  border-radius: var(--radius-lg);
  filter: grayscale(20%) contrast(1.05);
  transition: filter var(--transition);
}

.imageandre:hover { filter: grayscale(0%) contrast(1.1); }

/* Texto sobre */
#sobre article .section-title { max-width: 100%; margin: 0; margin-bottom: .25rem; }

/* Lista */
.about-list {
  display: flex;
  flex-direction: column;
  gap: .65rem;
  margin-top: 1.4rem;
}

.about-list li {
  display: flex;
  align-items: flex-start;
  gap: .7rem;
  font-size: .9rem;
  color: var(--text);
}

.check {
  flex-shrink: 0;
  width: 20px; height: 20px;
  border-radius: 50%;
  background: var(--accent-dim);
  border: 1px solid rgb(3, 3, 3);
  color: var(--logo);
  font-size: .7rem;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: .1rem;
}

/* ════════════════════════════════════════════
   FOOTER
════════════════════════════════════════════ */
footer#contato {
  background: transparent;
  font-size: 16px;
  min-height: 30vh;      /* já deve estar vindo de "main section, footer { min-height: 100vh }" */
  display: flex;
  flex-direction: column;
  justify-content: flex-end;   /* ← empurra todo o conteúdo pra base do footer */
}


.footer-section {
  max-width: 1640px;
  margin: 0 auto;
  padding: 1rem clamp(1.25rem, 5vw, 3rem) 2.5rem;
  bottom: 1%;
  
}

.footer-section > .section-label {
  display: block;
  margin-bottom: 1rem;
}

.footer-colunas {
  display: flex;
  flex-direction: row;
  gap: 15rem;
  justify-content: center;

}
.footer-col-item {
  display: flex;
  flex-direction: column;
  gap: .75rem;
  max-width: 420px;
  z-index: 101;

}

.footer-col-item h3 {
  font-size: 24px;
  font-weight: 5500px;
  color: var(--white);
  letter-spacing: .06em;
  text-transform: uppercase;
  margin-bottom: 1rem;
}

.footer-col-item ul {
  display: flex;
  flex-direction: column;
  gap: .55rem;
  margin-bottom: 1.2rem;
}

.footer-col-item ul li {
  font-size: .87rem;
  color: var(--muted);
}

.footer-col-item ul li a {
  color: var(--muted);
  transition: color var(--transition);
  min-width: 200px;
}

.footer-col-item ul li a:hover { color: var(--accent); }

/* Botões sociais */
.social-links {
  display: flex;
  gap: .65rem;
  margin-top: .75rem;
}

.social-btn {
  width: 40px; height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--surface2);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  font-size: 1.1rem;
  transition: border-color var(--transition), background var(--transition), transform var(--transition);
  background-image: url(../assets/icons8-instagram-240.png);
  background-size: 24px 24px;      /* ← tamanho do ícone dentro do botão */
  background-repeat: no-repeat;    /* ← impede o mosaico/repetição */
  background-position: center;     /* ← centraliza o ícone no botão */
}

.social-btn2 {
  width: 40px; height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--surface2);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  font-size: 1.1rem;
  transition: border-color var(--transition), background var(--transition), transform var(--transition);
  background-image: url(../assets/icons8-linkedin-240.png);
  background-size: 24px 24px;
  background-repeat: no-repeat;
  background-position: center;
}

.social-btn3 {
  width: 40px; height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--surface2);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  font-size: 1.1rem;
  transition: border-color var(--transition), background var(--transition), transform var(--transition);
  background-image: url(../assets/icons8-github-240.png);
  background-size: 24px 24px;
  background-repeat: no-repeat;
  background-position: center;
}
/* Barra inferior */
.footer-bottom {
  border-top: 1px solid var(--border);
  padding: 1.25rem clamp(1.25rem, 5vw, 3rem);
  text-align: center;
}

.footer-bottom span {
  font-size: .8rem;
  color: var(--muted);
  letter-spacing: .04em;
}
.editor-footer {
  background: transparent;
  margin-top: 3rem;                          /* espaço entre as colunas e o copyright */
  padding: 1.5rem clamp(1.25rem, 5vw, 3rem) 2.5rem;  /* espaço entre o copyright e a borda inferior */
  border-top: 1px solid var(--border);       /* linha divisória sutil, como você já tinha em .footer-bottom */
  text-align: center;
}

.editor-footer span {
  font-size: .8rem;
  color: var(--muted);
  letter-spacing: .04em;
}
/* ════════════════════════════════════════════
   RESPONSIVO
════════════════════════════════════════════ */
@media (max-width: 900px) {
  .hero-inner {
    flex-direction: column;
    text-align: center;
    padding-top: 2rem;
  }

  .hero-content { align-items: center; max-width: 100%; }
  .hero-btns    { justify-content: center; }

  .Confirma img#lido { width: clamp(180px, 55vw, 300px); }

  .about-grid { grid-template-columns: 1fr; }

  .about-placeholder {
    max-width: 340px;
    margin: 0 auto;
    aspect-ratio: 1;
  }

  .footer-colunas { grid-template-columns: 1fr; gap: 2rem; }
}

@media (max-width: 600px) {
  .nav-links { gap: 1rem; }
  .nav-links li a h4 { font-size: .8rem; }

  .hero-content h1 { font-size: 2rem; }
  .features-grid   { grid-template-columns: 1fr; }
}
button:focus,
a:focus {
   outline: 2px solid var(--accent);
   outline-offset: 4px;
}











@media (prefers-reduced-motion: reduce) {
  
  *, ::before, ::after {
    animation-delay: -1ms !important;
    animation-duration: 1ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 1ms !important;
    scroll-behavior: auto !important;
  }


 html {
    scroll-behavior: auto;
    
  
  }
  

  * {
    animation: none !important;
    transition: none !important;
  }

}

/* ── Desktop Grande (≥ 1201px | Acima de 12.51") ── */
@media (min-width: 1201px) {
    /*Html*/
   
    /*body*/
    /*Header*/
    /*Aside esquerdo*/
    /*Main*/
    /*Aside direito*/
    /*Footer*/
}
/* ── Desktop Padrão / Notebooks (993px até 1200px | 10.34" a 12.5") ── */
@media (min-width: 993px) and (max-width: 1200px) {
     html {
    scroll-behavior: auto;
    
  
  }
  body { font-size: 16px; }
  
  .hero-inner {
    gap: clamp(1.5rem, 4vw, 3rem); 
  padding: 0 clamp(1rem, 9vw, 4rem);
  }

  .features-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .about-grid {
    gap: 1.5rem;
  }

  .aside-left {
    left: .75rem;
  }

  .avaliacao-bloco {
    width: 190px;
  }
}
/* ── Tablets Grandes / iPad (769px até 992px | 8.01" a 10.33") ── */
@media (min-width: 769px) and (max-width: 992px) { 
 
    .hero-inner {
    flex-direction: column;
    text-align: center;
    padding-top: 2rem;
  }

  .hero-content {
    align-items: center;
    max-width: 100%;
  }

  .hero-btns { justify-content: center; }

  

  .about-grid {
    grid-template-columns: 1fr;
  }

  .about-placeholder {
    max-width: 340px;
    margin: 0 auto;
    aspect-ratio: 1;
  }

  .footer-colunas {
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  /* aside vira barra inferior */
  .aside-left {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    flex-direction: row;
    align-items: center;
    justify-content: top;
    gap: 1rem;
    width: 100%;
    max-height: 100%;
    padding: .6rem 1rem;
    background: rgba(14, 14, 17, .92);
    backdrop-filter: blur(12px);
    border-top: 1px solid var(--border);
    z-index: 99;
  }

  .aside-nav,
  .aside-pcd {
    flex-direction: row;
    gap: .5rem;
  }

  .avaliacao-bloco {
    width: 100%;
    max-width: 420px;
  }

  .avaliacao-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .65rem;
  }

  /* feedback e enviar ocupam largura total */
  .avaliacao-feedback,
  .avaliacao-enviar,
  .avaliacao-obrigado {
    grid-column: 1 / -1;
  }
}
/* ── Tablets Menores / Celular Deitado (577px até 768px | 6.01" a 8") ── */
@media (min-width: 577px) and (max-width: 768px) {
    :root { --header-height: 60px; }


  .nav-links { gap: .75rem; }
  .nav-links li a { font-size: .8rem; }
  .nav-cta { font-size: .85rem; padding: .4rem 1rem; }

  /* Hero */
  .hero { padding: 5rem 1.25rem 4rem; }
  .hero-content h1 { font-size: 1.9rem; }
  .hero-sub { font-size: .88rem; }

  /* Recursos */
  #recursos { padding: 4rem 1.25rem; }
  .features-grid { grid-template-columns: 1fr; }

  /* Sobre */
  #sobre { padding: 3rem 1.25rem; }

  /* Footer */
  .footer-colunas { grid-template-columns: 1fr; gap: 1.5rem; }
  .footer-section { padding: 3rem 1.25rem 2rem; }

  /* Aside vira barra inferior compacta */
  .aside-left { padding: .5rem .75rem; gap: .5rem; }
  .pcd-btn { width: 36px; height: 36px; font-size: .75rem; }

  /* Avaliação volta pra coluna única */
  .avaliacao-form { grid-template-columns: 1fr; }
  .avaliacao-bloco { width: 100%; }
}
  
/* ── Mobile pequeno (≤ 576px 6'(Polegadas)) ── */
@media (max-width: 576px) {
    
.hero-content h1 { font-size: 1.6rem; }
  .btn-primary,
  .btn-outline { font-size: .82rem; padding: .65rem 1.2rem; }

  .nav-links { gap: .5rem; }
  .btn-logo { font-size: 1.1rem; }
}
