  min-height: 100vh;
  max-width: 3000px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 6rem 5% 5rem;
  overflow: hidden;
}

.recursos1-layout {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 10rem;
  width: 100%;
  max-width: 1400px;
}

.textoRecursos1 {
  position: relative;
  background: transparent;
  width: 600px;
  height: 600px;
  box-sizing: border-box;
}

.textoRecursos1 h2 {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 6;
  width: 100%;
  background: transparent;
  text-align: center;
  font-size: 27px;
  color: var(--text);
  border-color: var(--border);
