/* ═══════════════════════════════════════════════
   a.asta.portfolio — base.css
   Tema: Dark Tech · Accent Lima-Elétrico
   Fontes: Syne (display) + Outfit (corpo)
═══════════════════════════════════════════════ */

@import url('https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;500;600;700;800&display=swap');

/* ── Variáveis ───────────────────────────────── */
:root {
  --bg:        #000000;
  --surface:   #727272;
  --surface2:  #5a5959;
  --border:    #030303;
  --accent:    #c8f55a;
  --accent-dim:#8fad33;
  --text:      #fff;
  --white:     #ffffff;
  --logo:      #fff;
  --logoborder:#7a7878;
  --muted:     #a7aaa9;
  --lilas:     #ab05f8;
  --yellow:    #cad620;
  --headerback: rgba(14, 14, 17, .75);
  --animation:  red;

  

  --font-head: 'consolas', sans-serif;
  --font-body: 'consolas', sans-serif;
  --font-scale: 1;

  --radius:    12px;
  --radius-lg: 20px;
  --header-height: 65px;
  --transition: .25s cubic-bezier(.4,0,.2,1);


}
/* ── Tema claro ── */
:root.tema-claro {
  --bg:        #f4f4f8;
  --surface:   #ffffff;
  --surface2:  #a7aaa9;
  --border:    #ccccdd;
  --text:      #000000;
  --white:     #1a1a2e;
  --accent:    #9a14f3;
  --accent-dim:#54409b;
 --logo:       #000000;
  --logoborder:#e4e1e1;
  --muted:     #000000;
  --lilas:     #cad620;
  --yellow:    #ab05f8;
  --headerback: rgba(50, 50, 116, 0.75);
  --animation:  rgb(252, 164, 2);
}
/* ── Tema neutro ── */
:root.tema-neutro {
  --bg:         #eae7e1;   
  --surface:    #f5f3ef;
  --surface2:   #d9d5cc;
  --border:     #c3beb3;
  --text:       #2f2e2b;   
  --white:      #383838;   
  --accent:     #5a7d94;   
  --accent-dim: #8a9aa8;
  --logo:       #2f2e2b;
  --logoborder: #c3beb3;
  --muted:      #6e6a62;
  --lilas:      #a99bc4;   
  --yellow:     #cdac5a;  
  --headerback: rgba(148, 148, 151, 0.75);
  --animation:  black;
}


*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

@media (prefers-reduced-motion: reduce) {
  
  *, ::before, ::after {
    animation-delay: -1ms !important;
    animation-duration: 1ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 1ms !important;
    scroll-behavior: auto !important;
  }


 html {
    scroll-behavior: auto;
    
   font-size: calc(clamp(14px, 0.85vw + 10px, 19px) * var(--font-scale));
  }
  

  * {
    animation: none !important;
    transition: none !important;
  }

}
html, body {
  scrollbar-width: auto;
  -ms-overflow-style: auto;
}

html::-webkit-scrollbar,
body::-webkit-scrollbar {
  display: none;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: 'DM Sans', sans-serif;
  font-size: 17px;
  line-height: 1.7;
  max-width: 100%;
  transition: filter 0.3s ease;
}
.protanopia   { filter: url('../assets/filtros.svg#protanopia');   }
.deuteranopia { filter: url('../assets/filtros.svg#deuteranopia'); }
.tritanopia   { filter: url('../assets/filtros.svg#tritanopia');   }
body.protanopia {
    filter: url('../assets/filtros.svg#protanopia');
}

.protanopia {
    filter: url('../assets/filtros.svg#protanopia');
}

.deuteranopia {
    filter: url('../assets/filtros.svg#deuteranopia');
}

.tritanopia {
    filter: url('../assets/filtros.svg#tritanopia');
}
img, video { display: block; max-width: 100%; }
a { text-decoration: none; color: inherit; }
ul { list-style: none; }
button { cursor: pointer; border: none; background: none; font-family: inherit; }
figure { margin: 0; }

h1,h2,h3,h4 { font-family: var(--font-head); line-height: 1.15; }

/* ════════════════════════════════════════════
   ASIDE LEFT — container fixo
════════════════════════════════════════════ */
.aside-left {
    position: fixed;
    inset: 45% 99% 55% 1%;
    z-index: 99;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: .5rem;
}
/* ════════════════════════════════════════════
   ASIDE LEFT — container fixo
════════════════════════════════════════════ */
.aside-left {
    position: fixed;
    top: 5%;
    left: 1%;
    width: 300px;
    max-width: 24px; 
    height: 100vh;  
    z-index: 99;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: .5rem;
    padding: 1rem;
    box-sizing: border-box; 
}


.aside-left.aberto {
    transform: translateX(0);
}

/* ── Botão toggle ── */
.aside-toggle {
    position: relative;
    right: 0; /* Gruda o botão na borda externa do menu */
    top: 0%; 
    
    width: 38px;
    max-width: 34px;
    height: 38px;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: border-color var(--transition), color var(--transition);
}







.aside-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
}

/* ── Conteúdo colapsável ── */
.aside-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-height: 0;
    overflow: auto;
    opacity: 0;
    pointer-events: none;
    transition: max-height .35s ease, opacity .25s ease;
}

.aside-left.aberto .aside-content {
    max-height: 80vh;
    opacity: 1;
    pointer-events: auto;
    overflow-y: auto;
}

.aside-content::-webkit-scrollbar { width: 4px; }
.aside-content::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 4px;
}



/* ── Botões PCD ── */
.aside-pcd {
    display:flex;
    flex-direction: column;
    gap: .55rem;
}

.pcd-container{
    position:relative;
    display:inline-block;
}

.pcd-btn{
    padding:10px 15px;
    cursor:pointer;
    border-radius:8px;
}
 .pcd-btnprincipal{
    padding:10px 15px;
    cursor:pointer;
    border-radius:8px;
    color: var(--text);
 }

.pcd-dropdown{
    display:none;
    position:absolute;
    top:100%;
    left:0;
    min-width:220px;
    background:#000000;
    border:1px solid #ecedee;
    border-radius:8px;
    z-index:999;
}

.pcd-option{
    width:100%;
    padding:12px;
    border:none;
    background:transparent;
    color:white;
    text-align:left;
    cursor:pointer;
}

.pcd-option:hover{
    background:#aaabad;
}
 
.pcd-container:hover .pcd-dropdown,
.pcd-dropdown:hover{
    display:block;
}


.pcd-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(200, 245, 90, .08);
    transform: translateX(3px);
}
.pcd-btn2:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(200, 245, 90, .08);
    transform: translateX(3px);
}
.pcd-btnprincipal{
    padding:10px 15px;
    cursor:pointer;
    border-radius:8px;
    color:var(--text);
    border:1px solid var(--border);
    background:var(--surface2);
}

.pcd-btnprincipal:hover{
    border-color:var(--accent);
    color:var(--accent);
}

/* ════════════════════════════════════════════
   AVALIAÇÃO
════════════════════════════════════════════ */
.avaliacao-bloco {
    display: flex;
    flex-direction: column;
    gap: .75rem;
    padding: 1rem;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    width: 260px;
}

.avaliacao-titulo {
    font-size: .85rem;
    font-weight: 700;
    color: var(--white);
    text-align: center;
    letter-spacing: .04em;
}

.avaliacao-form {
    display: flex;
    flex-direction: column;
    gap: .65rem;
}

.avaliacao-pergunta {
    display: flex;
    flex-direction: column;
    gap: .3rem;
    font-size: .50rem;
}

.avaliacao-pergunta span {
    font-size: .72rem;
    color: var(--muted);
}

.avaliacao-opcoes {
    display: flex;
    gap: .3rem;
}

.avaliacao-opcoes button {
    flex: 1;
    height: 28px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--muted);
    font-size: .75rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color var(--transition),
                color var(--transition),
                background var(--transition);
}

.avaliacao-opcoes button:hover {
    border-color: var(--accent);
    color: var(--accent);
}

.avaliacao-opcoes button.selecionado {
    background: rgba(200, 245, 90, .15);
    border-color: var(--accent);
    color: var(--accent);
}

/* ── Feedback ── */
.avaliacao-feedback {
    display: flex;
    flex-direction: column;
    gap: .35rem;
}

.avaliacao-feedback label {
    font-size: .72rem;
    color: var(--muted);
}

.avaliacao-feedback textarea {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-size: .78rem;
    padding: .5rem;
    resize: vertical;
    min-height: 70px;
    transition: border-color var(--transition);
}

.avaliacao-feedback textarea:focus {
    outline: none;
    border-color: var(--accent);
}

/* ── Botão enviar ── */
.avaliacao-enviar {
    background: var(--accent);
    color: var(--bg);
    border-radius: var(--radius);
    padding: .45rem;
    font-size: .8rem;
    font-weight: 700;
    transition: opacity var(--transition), transform var(--transition);
}

.avaliacao-enviar:disabled {
    opacity: .35;
    cursor: not-allowed;
}

.avaliacao-enviar:not(:disabled):hover {
    opacity: .85;
    transform: translateY(-1px);
}

/* ── Obrigado ── */
.avaliacao-obrigado {
    text-align: center;
    font-size: .85rem;
    color: var(--accent);
    font-weight: 600;
    padding: .5rem 0;
}



/* ════════════════════════════════════════════
   HEADER / NAV
════════════════════════════════════════════ */
header#Inicial {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  height: var(--header-height);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 clamp(1.25rem, 5vw, 3rem);
  background: var(--headerback);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--border);
  transition: background var(--transition);
}

/* Logo */
.nav-logo { 
    display: flex; 
    align-items: center; 
    position: fixed;
    top: 100px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 999;
    transition:
        top 0.6s ease,
        left 0.6s ease,
        transform 0.6s ease,
        scale 0.4s ease;
     
}

/* Estado ao rolar */

.nav-logo.scrolled {
    top: 10px;
    left: 65px;
    transform: translateX(0);
    scale: 0.88;
}
.nav-logo.scrolled .btn-logo {
  font-size: 35px;   
}

.btn-logo {
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
  font-weight: 800;
    color: var(--logo);
    -webkit-text-stroke:  var(--logoborder);


  letter-spacing: -.01em;
  font-size: 72px;
   transition: font-size .6s ease;
  
}

.btn-logo ::after {
  content: '';
  display: block;
  height: 2px;
  width: 0;
  background: var(--logo);
  transition: width var(--transition);
  margin-top: 2px;
  font-size: 12px;
}

.btn-logo:hover ::after { width: 100%; }

/* Links nav */
.nav-menu { 
    display: flex;
    gap: 8rem;
    list-style: none;
    flex: 2;
    justify-content: center;
    align-items: flex-end;
    
    
    padding-bottom: 1px; 
}

.nav-links {
  display: flex;
  gap: 2rem;
  align-items: center;
}

.nav-links li a {
  position: relative;
  color: var(--muted);
  transition: color var(--transition);
}

.nav-links li a h4 {
  font-size: 14px;
  font-weight: 500;
  letter-spacing: .02em;
  color: #ffffff;
}

.nav-links li a::after {
  content: '';
  position: absolute;
  bottom: -3px; left: 0;
  width: 0; height: 1px;
  background: var(--accent);
  transition: width var(--transition);
}

.nav-links li a:hover { color: var(--text); }
.nav-links li a:hover::after { width: 100%; }


/* CTA Entrar */
.nav-cta-wrapper { display: flex; align-items: center; }

.nav-cta {
  background: var(--accent);
  color: var(--bg);
  border-radius: var(--radius);
  padding: .5rem 1.4rem;
  transition: background var(--transition), transform var(--transition);
  font-size: 18px;
  font-weight: 600;
  letter-spacing: .02em;
}



.nav-cta:hover {
    opacity: .92;
    background: #d8ff6a;
    transform: translateY(-1px);
}


/* ════════════════════════════════════════════
   Main
════════════════════════════════════════════ */
main section,
footer {
    min-height: 100vh;
}

/* ════════════════════════════════════════════
   HERO
════════════════════════════════════════════ */
.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 6rem 5% 5rem;
 
}
.hero-blobs-wrapper {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: clip;
  pointer-events: none;
  z-index: 0;
}

/* Blobs de fundo */
.hero-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(100px);
  pointer-events: none;
  z-index: 0;
}

.blob1 {
    width: 560px; height: 560px;
    top: -80px; left: -120px;
    background: radial-gradient(circle, var(--accent), transparent 70%);
    animation: blobFloat 8s ease-in-out infinite;
}

.blob2 {
  width: 480px; height: 480px;
  bottom: -60px; right: -100px;
  background: radial-gradient(circle, var(--accent-dim), transparent 70%);
  animation: blobFloat2 8s ease-in-out infinite;
}

@keyframes blobFloat {
  0%,100% { transform: translate(0,0) scale(1); }
  50%      { transform: translate(30px, 30px) scale(1.05); }
}
@keyframes blobFloat2 {
  0%,100% { transform: translate(5px,0) scale(1); }
  50%      { transform: translate(80px, 30px) scale(1.05); }
}

/* Inner layout */
.hero-inner {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 3rem;
  width: 100%;
  max-width: 1160px;
  padding: 0 clamp(1.25rem, 5vw, 3rem);
}

.hero-content {
  flex: 1;
  max-width: 580px;
  display: flex;
  flex-direction: column;
  gap: 1.4rem;
}

/* Badge */
.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: .55rem;
  background: var(--accent-back);
  border: 1px solid rgba(200,245,90,.25);
  color: var(--accent);
  font-size: .8rem;
  font-weight: 500;
  letter-spacing: .04em;
  text-transform: uppercase;
  padding: .35rem .85rem;
  border-radius: 99px;
  width: fit-content;
}

.badge-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--accent);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%,100% { opacity: 1; transform: scale(1); }
  50%      { opacity: .5; transform: scale(.7); }
}

/* H1 */
.hero-content h1 {
  font-size: clamp(2.2rem, 5vw, 3.4rem);
  font-weight: 800;
  color: var(--text);
  letter-spacing: -.025em;
}

.hero-content h1 em {
  font-style: normal;
  background: linear-gradient(90deg, #725821 0%, #c7950c 60%, #e6ac2f 100%);
  -webkit-background-clip: text; 
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.hero h4 {
position: absolute;
  bottom: -25%;
  left: 70%;
  transform: translate(-50%, -45%);
  z-index: 99;
  width: 100%;
  max-width: 520px;
  background: transparent;
  text-align: left;
  font-size: 20px;
  color: var(--logo);
  border-color: var(--border);}
 

.hero-sub {
  font-size: 1rem;
  color: var(--text);
  max-width: 480px;
  line-height: 1.7;
}

/* Botões hero */
.hero-btns {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.btn-primary {
  background: var(--accent);
  color: var(--bg);
  font-size: .92rem;
  font-weight: 600;
  padding: .75rem 1.8rem;
  border-radius: var(--radius);
  transition: background var(--transition), transform var(--transition), box-shadow var(--transition);
  box-shadow: 0 0 0 0 rgba(200,245,90,0);
}

.btn-primary:hover {
  background: #d8ff6a;
  transform: translateY(-2px);
  box-shadow: 0 8px 28px rgba(200,245,90,.3);
}

.btn-outline {
  background: transparent;
  color: var(--text);
  font-size: .92rem;
  font-weight: 500;
  padding: .75rem 1.8rem;
  border-radius: var(--radius);
  border: 1px solid var(--border);
  transition: border-color var(--transition), color var(--transition), transform var(--transition);
}

.btn-outline:hover {
  border-color: var(--accent);
  color: var(--accent);
  transform: translateY(-2px);
}





/* Scroll indicator */
.hero-scroll {
  position: absolute;
  bottom: 2rem;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: .5rem;
  z-index: 1;
}

.hero-scroll span {
  font-size: .7rem;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--muted);
}

.scroll-line {
  width: 1px;
  height: 48px;
  background: linear-gradient(to bottom, var(--text), transparent);
  animation: scrollLine 1.8s ease-in-out infinite;
}

@keyframes scrollLine {
  0%   { opacity: 0; transform: scaleY(0); transform-origin: top; }
  50%  { opacity: 1; transform: scaleY(1); transform-origin: top; }
  100% { opacity: 0; transform: scaleY(1); transform-origin: bottom; }
}

/* ════════════════════════════════════════════
   RECURSOS — ocupa a tela toda
════════════════════════════════════════════ */
#recursos {
  position: relative;
  height: 110vh;           /* tela toda, não só min-height */
  max-width: 2600px;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 6rem 5% 5rem;
  overflow: hidden;
  box-sizing: border-box;
}





.features-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  transition: grid-template-columns .6s ease;  
  gap: 1.5rem;
  width: 100%;
  flex: 1;
  min-height: 0;
  margin-top: 1.5rem;
  background-color: transparent;
  overflow: hidden;
  z-index: 9;
}

.feature-card {
  transition: margin .6s ease, z-index 0s;
  position: relative;
  z-index: 1;
}

.feature-card a {
  display: flex;
  flex-direction: column;
  height: 100%;
  text-decoration: none;
  color: inherit;
}


.feature-card h2 {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  margin: 0;
  padding: 1rem;
}

.feature-video-wrapper {
  position: relative;
  flex: 1;
  width: 100%;
  min-height: 0;
  min-width: 0; 
  overflow: hidden;
}
.feature-card:nth-child(1) .feature-video-wrapper::after,
.feature-card:nth-child(2) .feature-video-wrapper::after {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, .95);
  opacity: 2;
  transition: opacity .4s ease;
  pointer-events: none;
  z-index: 1;
}

.feature-card.video-ativo .feature-video-wrapper::after {
  opacity: 0;
}

/* garante que os botões fiquem acima da capa */
.video-toggle,
.video-restart {
  z-index: 2;
}

.feature-video{
  width: 185%;
  height: 85%;
  object-fit: cover;
  display: block;
  background: var(--surface2);
}
.feature-video1{
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  background: var(--surface2);
}
.feature-video2{
  flex: 5;
  justify-self: right;
  height: 100%;
  object-fit: cover;
  display: block;
  background: var(--surface2);
}

.video-toggle {
  position: absolute;
  bottom: .75rem;
  right: .75rem;
  z-index: 2;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: rgba(0, 0, 0, .6);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: .85rem;
  cursor: pointer;
  transition: background var(--transition), transform var(--transition);
}

.video-toggle:hover {
  background: rgba(0, 0, 0, .85);
  transform: scale(1.1);
}
.feature-card:nth-child(1) a,
.feature-card:nth-child(3) a {
  flex-direction: column-reverse;
}

.feature-card:nth-child(3) .feature-video-wrapper {
  flex: 15;   
}
.video-restart {
  position: absolute;
  bottom: .75rem;
  right: 3.5rem;   /* fica à esquerda do video-toggle, que está em right: .75rem */
  z-index: 2;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: rgba(0, 0, 0, .6);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: .95rem;
  cursor: pointer;
  transition: background var(--transition), transform var(--transition);
}

.video-restart:hover {
  background: rgba(0, 0, 0, .85);
  transform: scale(1.1) rotate(-45deg);
}

.feature-card:not(.video-ativo) .video-toggle,
.feature-card:not(.video-ativo) .video-restart {
  pointer-events: none;
}

.video-mute {
  position: absolute;
  bottom: .75rem;
  right: 6.25rem;   /* fica à esquerda do video-restart (3.5rem) */
  z-index: 2;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: rgba(0, 0, 0, .6);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: .95rem;
  cursor: pointer;
  transition: background var(--transition), transform var(--transition);
}

.video-mute:hover {
  background: rgba(0, 0, 0, .85);
  transform: scale(1.1);
}
/* ════════════════════════════════════════════
   RECURSOS0 — Acessibilidade (círculo + tópicos)
════════════════════════════════════════════ */
#recursos0 {
  position: relative;
  min-height: 100vh;
  max-width: 3000px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 6rem 5% 5rem;
  overflow: hidden;
}

.recursos0-layout {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rem;
  width: 100%;
  max-width: 1400px;
}

.textoRecursos0 {
  position: relative;
  background: transparent;
  width: 600px;
  height: 600px;
  box-sizing: border-box;
}

.textoRecursos0 h2 {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 6;
  width: 100%;
  background: transparent;
  text-align: center;
  font-size: 29px;
  color: var(--text);
  border-color: var(--border);
  letter-spacing: 3px;
  text-transform: uppercase;
  transition: transform .5s;
}
.textoRecursos0 p {
  position: absolute;
  top: 2%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 99;
  width: 100%;
  background: transparent;
  text-align: center;
  font-size: 16px;
  color: grey;
  border-color: var(--border);
  letter-spacing: 3px;
  text-transform: uppercase;
  
}

.textoRecursos0 .frente {
  position: absolute;
  border-radius: 50%;
  border: 2px solid var(--muted);
}

.textoRecursos0 .frente.frente1 {
  top: 2px; left: 2px; right: 2px; bottom: 2px;
  background: transparent;
  box-shadow: 0 0 10px var(--bg);
  border-left: 2px solid var(--accent-dim);
  border-top: 2px solid var(--accent-dim);
  animation: girar 20s linear infinite;
}

.textoRecursos0 .frente.frente2 {
  top: -1px; left: -1px; right: -1px; bottom: -1px;
  background: transparent;
  box-shadow: 0 0 10px var(--bg);
  border-left: 2px solid var(--accent-dim);
  border-top: 2px solid var(--accent-dim);
  animation: girar 14s linear reverse infinite;
}

.textoRecursos0 .frente .circulo {
  position: absolute;
  top: calc(50% - 1px);
  left: 50%;
  transform-origin: left;
  width: 50%;
  height: 2px;
}

.textoRecursos0 .frente.frente1 .circulo {
  transform: rotate(-45deg);
}

.textoRecursos0 .frente.frente2 .circulo {
  transform: rotate(45deg);
}


.textoRecursos0 .frente.frente1 .circulo::before {
  background: var(--accent-dim);
  box-shadow:
    0 0 30px var(--accent-dim),
    0 0 40px var(--accent-dim),
    0 0 60px var(--accent-dim),
    0 0 80px var(--accent-dim),
    0 0 100px var(--accent-dim),
    0 0 5px var(--lilas);
}

.textoRecursos0 .frente.frente2 .circulo::before {
  background: var(--accent);
  box-shadow:
    0 0 30px var(--accent),
    0 0 40px var(--accent),
    0 0 60px var(--accent),
    0 0 80px var(--accent),
    0 0 100px var(--accent),
    0 0 5px var(--yellow);
}



/* ════════════════════════════════════════════
   RECURSOS1 — Desenvolvimento do Som (círculo + tópicos)
════════════════════════════════════════════ */
#recursos1 {
